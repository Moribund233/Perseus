{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LanGit Server Manager",
  "version": "0.1.0",
  "identifier": "com.langit.server-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LanGit Server Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "http:default",
            "dialog:default",
            {
              "identifier": "http:default",
              "allow": [
                {
                  "url": "http://**"
                },
                {
                  "url": "https://**"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LanGit 服务端管理工具",
    "longDescription": "用于管理 LanGit 服务端的生命周期、监控性能、查看日志和配置管理"
  }
}
