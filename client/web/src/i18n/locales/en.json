    "features": {
      "title": "Everything your team needs",
      "subtitle": "Self-hosted Git platform with built-in collaboration tools designed for modern development teams.",
      "codeHosting": {
        "title": "Code Hosting",
        "desc": "Self-hosted Git repository hosting with branch protection, webhooks, and fine-grained access control."
      },
      "teamChat": {
        "title": "Team Chat",
        "desc": "Real-time messaging with channels, threads, and rich code snippets. Keep discussions in context."
      },
      "codeReview": {
        "title": "Code Review",
        "desc": "Inline pull request reviews with threaded discussions, approval workflows, and merge checks."
      },
      "realtimeEditing": {
        "title": "Real-time Editing",
        "desc": "Collaborative code editing with live cursors, presence awareness, and CRDT-based conflict resolution."
      },
      "issueTracking": {
        "title": "Issue Tracking",
        "desc": "Manage issues with labels, milestones, batch operations, and integrations with your Git workflow."
      },
      "releaseManagement": {
        "title": "Release Management",
        "desc": "Tag releases, attach assets, publish release notes. Integrated with your repository and webhook system."
      }
    },
    "collab": {
      "title": "Real-time collaboration, built in",
      "description": "Edit code together with your team just like Google Docs. See who's working on what, discuss in real-time, and never worry about merge conflicts again.",
      "items": [
        "Multiple cursors and presence indicators",
        "Inline code review with threaded discussions",
        "CRDT-based conflict-free synchronization",
        "Real-time team chat alongside your code"
      ]
