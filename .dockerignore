# =============================================================================
# Docker 构建忽略规则
# =============================================================================

# 版本控制
.git
.gitignore
.gitattributes

# 环境文件（可能包含密钥）
.env
.env.*

# 本地开发配置
config.toml
*.backup.*
*.pid

# 本地数据目录（仓库存储）
repositories/
logs/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 测试文件（仅运行时不需要）
tests/
test_*.py

# 开发工具
.idea/
.vscode/
*.swp
*.swo

# 操作系统文件
Thumbs.db
.DS_Store
