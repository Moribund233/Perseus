# =============================================================================
# Perseus 测试镜像
#
# 基于生产应用镜像 (perseus-app:latest) 追加测试依赖, 运行 pytest。
# 源码通过 compose 卷挂载 (./:/app), 改动代码无需重新构建本镜像。
#
# 用法 (在编排目录):
#   docker compose --profile test build test
#   docker compose --profile test run --rm test                       # 全量
#   docker compose --profile test run --rm test tests/test_collab_ws.py
# =============================================================================
FROM perseus-app:latest

USER root

# 测试期编译依赖 (与生产构建阶段一致) + ripgrep (代码搜索测试需要)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    libgit2-dev \
    libpq-dev \
    pkg-config \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# 阿里云 PyPI 镜像
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_TRUSTED_HOST=mirrors.aliyun.com

# pytest 及测试栈依赖 (对应 pyproject [project.optional-dependencies].dev)
# 注意: tests/ 被 .dockerignore 排除, 测试代码通过 compose 卷挂载 ./tests:/app/tests
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    respx \
    httpx \
    aiosqlite \
    -i https://mirrors.aliyun.com/pypi/simple/

USER perseus

WORKDIR /app

CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]
